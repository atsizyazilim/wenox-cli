{
  "name": "@wenox/cli",
  "version": "0.1.1",
  "description": "Official CLI for WenOX AI — an agentic coding assistant for your terminal",
  "type": "module",
  "bin": {
    "wenox": "./bin/wenox.js"
  },
  "files": [
    "bin",
    "dist/src",
    "README_tr.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "prestart": "npm run build",
    "start": "node bin/wenox.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wenox",
    "cli",
    "ai",
    "coding-assistant",
    "agent"
  ],
  "homepage": "https://github.com/atsizyazilim/wenox-cli#readme",
  "bugs": "https://github.com/atsizyazilim/wenox-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsizyazilim/wenox-cli.git"
  },
  "author": "ATSIZ YAZILIM LTD",
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "htm": "^3.1.1",
    "ink": "^7.1.1",
    "marked": "^18.0.12",
    "openai": "^7.15.0",
    "ora": "^9.4.1",
    "react": "^19.3.0",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
