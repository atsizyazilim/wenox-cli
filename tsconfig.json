{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],
    "jsx": "react-jsx",

    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "noEmitOnError": true,

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "declaration": false,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
